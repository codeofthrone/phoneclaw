PORT=8787

# Proxy auth between PhoneClaw -> proxy (recommended)
PROXY_BEARER_TOKEN=replace_with_long_random_secret

# Mode: apikey | oauth
GEMINI_MODE=oauth
GEMINI_MODEL=gemini-2.5-flash

# --- API key mode ---
# Only set this when GEMINI_MODE=apikey.
# Leave empty for oauth mode.
GEMINI_API_KEY=

# --- OAuth CLI mode ---
# Path to gemini CLI binary (default: gemini)
GEMINI_CLI_PATH=gemini
# CLI timeout in ms
GEMINI_CLI_TIMEOUT_MS=120000
GEMINI_CLI_USE_MODEL=false
